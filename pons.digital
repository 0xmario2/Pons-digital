<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PONS DIGITAL - Your identity, .digital</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;font-family:Inter,-apple-system,sans-serif}
  body{background:#ffffff;color:#0f2342;min-height:100vh;display:flex;flex-direction:column;align-items:center}
  header{width:100%;max-width:1100px;padding:20px 24px;display:flex;justify-content:space-between;align-items:center}
  .brand{display:flex;align-items:center;gap:12px;font-weight:800;letter-spacing:4px;font-size:18px}
  .brand img{width:42px;height:42px;object-fit:contain}
  .nav a{margin-left:16px;text-decoration:none;color:#0f2342;font-weight:600;font-size:14px;border:1px solid #e5e7eb;padding:8px 16px;border-radius:100px}
  .nav a.primary{background:#0f2342;color:white;border-color:#0f2342}
  .hero{margin-top:40px;text-align:center;padding:0 20px;width:100%;max-width:700px}
  .hero img{width:160px;height:160px;object-fit:contain;filter:drop-shadow(0 20px 40px rgba(127,184,154,0.4))}
  .hero h1{margin-top:28px;font-size:38px;letter-spacing:8px;font-weight:900}
  .hero p{margin-top:12px;color:#6b7a90;font-size:20px;letter-spacing:1px}
  
  .mint-box{margin-top:36px;background:#f8fafc;border:1px solid #eef2f7;border-radius:20px;padding:16px;display:flex;gap:12px;width:100%}
  .mint-box input{flex:1;border:none;background:white;padding:16px 20px;border-radius:12px;font-size:18px;font-weight:600;outline:none}
  .mint-box span{align-self:center;font-weight:800;color:#7fb89a;font-size:18px;padding-right:4px}
  .mint-box button{background:#0f2342;color:white;border:none;padding:0 28px;border-radius:12px;font-weight:700;font-size:16px;cursor:pointer}
  .mint-box button:disabled{background:#cbd5e1;cursor:not-allowed}
  
  #status{margin-top:16px;font-size:14px;color:#6b7a90;min-height:20px}
  .grid{margin-top:60px;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;width:100%;max-width:1100px;padding:0 20px 40px 20px}
  .card{border:1px solid #eef2f7;border-radius:16px;padding:20px;text-align:left}
  .card h3{font-size:14px;letter-spacing:1px;margin-bottom:6px}
  .card p{font-size:13px;color:#6b7a90}
  footer{padding:30px;color:#9ca3af;font-size:13px}
  footer a{color:#0f2342;text-decoration:none;font-weight:700}
</style>
</head>
<body>

<header>
  <div class="brand"><img src="logo.png" alt="P"> PONS DIGITAL</div>
  <div class="nav">
    <a href="https://x.com/Pons_digital" target="_blank">𝕏 @Pons_digital</a>
    <a href="#mint" class="primary">Mint</a>
  </div>
</header>

<div class="hero">
  <img src="logo.png" alt="P logo">
  <h1>PONS DIGITAL</h1>
  <p>Your identity, .digital</p>

  <div class="mint-box" id="mint">
    <input id="nameInput" placeholder="your name" oninput="checkName()">
    <span>.digital</span>
    <button id="mintBtn" onclick="mintName()" disabled>Mint</button>
  </div>
  <div id="status">Enter a name to claim on Robinhood Chain</div>
</div>

<div class="grid">
  <div class="card"><h3>IDENTITY LAYER</h3><p>One .digital name for wallet, DAO, and socials on Robinhood Chain.</p></div>
  <div class="card"><h3>Pons Family</h3><p>Part of Pons ecosystem. Not just a domain, your on-chain reputation.</p></div>
  <div class="card"><h3>MINT NOW</h3><p>Connect wallet coming soon. Claim early names before they’re taken.</p></div>
</div>

<footer>Built for <a href="https://x.com/Pons_digital">Pons_digital</a> • ponsfamily.com</footer>

<script>
const taken = JSON.parse(localStorage.getItem('pons_taken') || '["pons","admin","founder"]');
function checkName(){
  const v = document.getElementById('nameInput').value.toLowerCase().trim();
  const btn = document.getElementById('mintBtn');
  const st = document.getElementById('status');
  if(!v){ btn.disabled=true; st.textContent="Enter a name to claim on Robinhood Chain"; return; }
  if(v.length < 3){ btn.disabled=true; st.textContent="Name too short (min 3)"; st.style.color="#ef4444"; return; }
  if(taken.includes(v)){ btn.disabled=true; st.textContent=`${v}.digital is already taken`; st.style.color="#ef4444"; return; }
  btn.disabled=false; st.textContent=`${v}.digital is available!`; st.style.color="#22c55e";
}
function mintName(){
  const v = document.getElementById('nameInput').value.toLowerCase().trim();
  if(!v || taken.includes(v)) return;
  taken.push(v);
  localStorage.setItem('pons_taken', JSON.stringify(taken));
  document.getElementById('status').innerHTML = `✅ <b>${v}.digital</b> minted! Share on <a href="https://x.com/intent/tweet?text=I%20just%20minted%20${v}.digital%20on%20@Pons_digital%20%F0%9F%9F%A2" target="_blank">Twitter</a>`;
  document.getElementById('mintBtn').disabled=true;
  alert(v + '.digital berhasil di-mint! (simulasi, tinggal connect smart contract)');
}
</script>
</body>
</html>
